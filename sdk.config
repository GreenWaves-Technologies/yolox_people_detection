CONFIG_DEMO=y

# Board settings
CONFIG_PLATFORM_BOARD=y
CONFIG_BOARD_GAP9MOD_V1_0_B=y
CONFIG_BOARD_GAP9EVK_V2_0=y

# Cluster stack size for master core and other cores
CONFIG_FC_APP_MAIN_STACK_SIZE=4096
CONFIG_CL_MASTER_CORE_STACK_SIZE=4096
CONFIG_CL_SLAVE_CORE_STACK_SIZE=1024

# Boot options
CONFIG_BOOT_DEVICE_JTAG=n
CONFIG_BOOT_DEVICE_MRAM=y

# GAP_LIBs
CONFIG_LIB_GAP_LIB=y
CONFIG_LIB_GAP_LIB_IMG_IO=y
CONFIG_LIB_GAP_LIB_JPEG=y

# Autotiler Options
CONFIG_ENABLE_AUTOTILER=y
CONFIG_CNN_SQ8=y
CONFIG_CNN_POW2=n
CONFIG_CNN_FP16=y
CONFIG_CNN_NE16=y
CONFIG_MODEL_HAS_NO_CONSTANTS=n
CONFIG_MODEL_FLASH_TYPE_DEFAULT=n
CONFIG_MODEL_FLASH_TYPE_MRAM=y
CONFIG_MODEL_RAM_TYPE_DEFAULT=y
CONFIG_NEW_TILER_DSP_LIB=y

# Memory sizes for cluster L1, SoC L2 and Flash
CONFIG_MODEL_L1_MEMORY=128000
CONFIG_MODEL_L2_MEMORY=1200000
CONFIG_MODEL_L3_MEMORY=8000000
CONFIG_MODEL_LOGLEVEL=1

# Drivers
CONFIG_DRIVER_HOSTFS=y
CONFIG_DRIVER_READFS=y
CONFIG_DRIVER_TYPE_FLASH=y
CONFIG_DRIVER_TYPE_RAM=y
CONFIG_DRIVER_TYPE_CAMERA=y
CONFIG_DRIVER_HM0360=y
CONFIG_DRIVER_HM0360_FORMAT_VGA=y
CONFIG_DRIVER_SPIM=y
CONFIG_DRIVER_UDMAUART=y
